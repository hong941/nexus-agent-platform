# Demo mode works without any key.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Set these to use any OpenAI-compatible chat completions endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# Optional production RAG. Install requirements-rag.txt first.
USE_CHROMA=false
EMBEDDING_MODEL=
HF_HOME=./backend/data/huggingface

